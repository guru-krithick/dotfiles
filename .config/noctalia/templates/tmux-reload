#!/usr/bin/env bash
# Post-hook for the tmux template: re-source tmux.conf in every running server
# that loaded it, so open sessions recolour. A missing tmux or server is fine.
conf="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf"
command -v tmux >/dev/null 2>&1 || exit 0
for sock in "${TMUX_TMPDIR:-/tmp}/tmux-$(id -u)"/*; do
  [ -S "$sock" ] || continue
  files="$(tmux -N -S "$sock" display-message -p '#{config_files}' 2>/dev/null)" || continue
  case ",$files," in
    *",$conf,"*) tmux -N -S "$sock" source-file "$conf" >/dev/null 2>&1 ;;
  esac
done
exit 0
