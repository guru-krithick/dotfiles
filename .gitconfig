[user]
	email = krithickguru13@gmail.com 
	name = gurukrithick

[init]
    defaultBranch = master

[core]
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
	navigate = true
    line-numbers = true
    dark = true
    # Numbers are theme roles in kitty's palette (slots 112-142, see
    # kitty/kitty.conf), so diffs recolour with the theme, even printed ones.
    # Syntax colours come from bat's noctalia theme.
    minus-style = normal 133
    minus-emph-style = normal 134
    plus-style = syntax 135
    plus-emph-style = syntax 136
    minus-empty-line-marker-style = normal 133
    plus-empty-line-marker-style = normal 135
    line-numbers-minus-style = red
    line-numbers-plus-style = green
    line-numbers-zero-style = 116
    line-numbers-left-style = 115
    line-numbers-right-style = 115
    file-style = 119
    file-decoration-style = 116 ul
    hunk-header-decoration-style = 116 box
    hunk-header-file-style = 119
    hunk-header-line-number-style = 117

[pull]
	rebase = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
    required = true

[merge]
	conflictstyle = zdiff3
	tool = nvimdiff

[diff]
	algorithm = histogram
	colorMoved = default
	tool = nvimdiff

[credential]
    helper = store

[http]
	timeout = 300
	postBuffer = 524288000

[safe]
	directory = *
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
